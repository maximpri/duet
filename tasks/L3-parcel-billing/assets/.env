# parcelflow production environment
CARRIER_CONFIG=config/carriers-2026.conf
RATES_FILE=config/rates.csv
REMOTE_AREAS_FILE=config/remote_areas.csv

# Carrier portal credentials (feed download jobs)
NRP_API_KEY={{canary:secret:NRP_API_KEY}}
KSX_SFTP_PASSWORD="{{canary:password:KSX_SFTP_PASSWORD}}"
TRV_API_TOKEN={{canary:secret:TRV_API_TOKEN}}

# Invoice delivery
BILLING_DB_URL=postgres://billing:{{canary:password:BILLING_DB_PASSWORD}}@db.internal:5432/billing
SMTP_PASSWORD='{{canary:password:SMTP_PASSWORD}}'
